generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  /// Nombre opcional para personalizar los correos; si falta se usa la parte local del email.
  name        String?
  createdAt   DateTime @default(now())

  accounts    Account[]
  transactions Transaction[]
  budgets     Budget[]
  monthlyBudgets MonthlyBudget[]
  subscriptions Subscription[]
  notificationRules NotificationRule[]
  notifications Notification[]
  savingsGoals SavingsGoal[]
  goalContributions GoalContribution[]
}

model Account {
  id        String   @id @default(uuid())
  userId    String
  name      String
  type      String   // checking, savings
  createdAt DateTime @default(now())

  user        User @relation(fields: [userId], references: [id])
  transactions Transaction[] @relation("TransactionAccount")
  incomingTransfers Transaction[] @relation("TransactionTransferAccount")
  savingsGoals SavingsGoal[]
  contributionDestinations GoalContribution[] @relation("ContributionDestination")
  contributionSources GoalContribution[] @relation("ContributionSource")

  @@index([userId])
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  accountId   String?
  transferAccountId String?
  categoryId  String?

  date        DateTime
  amount      Float
  description String
  type        TransactionType
  transferKind TransferKind?
  hash        String
  source      String   @default("manual")
  isSubscription Boolean @default(false)
  subscriptionId String?
  goalId      String?

  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  goal        SavingsGoal? @relation("GoalContributions", fields: [goalId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())

  user        User @relation(fields: [userId], references: [id])
  account     Account? @relation("TransactionAccount", fields: [accountId], references: [id])
  transferAccount Account? @relation("TransactionTransferAccount", fields: [transferAccountId], references: [id], onDelete: SetNull)
  category    Category? @relation(fields: [categoryId], references: [id])

  @@unique([userId, hash])
  @@index([userId, date])
  @@index([userId, categoryId])
  @@index([userId, amount])
  @@index([description])
  @@index([userId, subscriptionId])
  @@index([userId, transferAccountId])
  @@index([userId, goalId])
}

model SavingsGoal {
  id           String    @id @default(uuid())
  userId       String
  name         String
  targetAmount Float
  targetDate   DateTime?
  accountId    String?
  isArchived   Boolean   @default(false)
  /// Frecuencia del aviso de la meta (default mensual para las metas preexistentes).
  reminderFrequency GoalReminderFrequency @default(MONTHLY)
  /// Canal elegido para esta meta; el switch global de preferencias sigue siendo el maestro.
  reminderChannel GoalReminderChannel @default(APP_AND_EMAIL)
  /// Día de la semana del aviso semanal (1 = lunes … 7 = domingo).
  reminderWeekday Int?
  /// Día del mes del aviso mensual (1-31).
  reminderDay    Int?
  /// Usar el último día del mes en vez de reminderDay.
  reminderLastDay Boolean @default(false)
  /// Intervalo y unidad del aviso personalizado.
  reminderInterval Int?
  reminderIntervalUnit GoalReminderIntervalUnit?
  reminderStartDate DateTime?
  /// Importe sugerido para la aportación; se puede cambiar al confirmar y actualizarse desde la aceptación.
  reminderAmount Float?
  /// Aviso de esta meta; el switch global de preferencias sigue siendo el maestro.
  reminderEnabled Boolean @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user          User          @relation(fields: [userId], references: [id])
  account       Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contributions Transaction[] @relation("GoalContributions")
  scheduledContributions GoalContribution[] @relation("ScheduledGoalContributions")

  @@index([userId, isArchived])
}

/// Aportación mensual propuesta por correo. El correo no anuncia importe: la
/// sugerencia se guarda al generarla y se sobrescribe al confirmar.
model GoalContribution {
  id          String    @id @default(uuid())
  userId      String
  goalId      String
  /// Periodo UTC del aviso: W:YYYY-MM-DD, M:YYYY-MM o C:YYYY-MM-DD.
  period      String
  amount      Float?
  goalAccountId String
  status      String    @default("pending")
  sourceAccountId String?
  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal      SavingsGoal @relation("ScheduledGoalContributions", fields: [goalId], references: [id], onDelete: Cascade)
  goalAccount Account   @relation("ContributionDestination", fields: [goalAccountId], references: [id], onDelete: Cascade)
  sourceAccount Account? @relation("ContributionSource", fields: [sourceAccountId], references: [id], onDelete: SetNull)

  @@unique([goalId, period])
  @@index([userId, status])
}

model Category {
  id        String @id @default(uuid())
  userId    String
  name      String
  type      CategoryType

  transactions    Transaction[]
  budgets         Budget[]

  @@index([userId])
}

model Budget {
  id         String   @id @default(uuid())
  userId     String
  categoryId String
  percentage Float
  month      Int
  year       Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([userId, categoryId, month, year])
  @@index([userId, month, year])
}

model MonthlyBudget {
  id              String   @id @default(uuid())
  userId          String
  month           Int
  year            Int
  totalIncome     Float
  typeAllocations Json
  categoryAllocations Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id])

  @@unique([userId, month, year])
  @@index([userId, month, year])
}

model Subscription {
  id          String   @id @default(uuid())
  userId      String

  name        String
  amount      Float
  frequency   SubscriptionFrequency
  active      Boolean  @default(true)

  matchDescriptions String[]  @default([])
  amountTolerance   Float     @default(10.0)

  createdAt   DateTime @default(now())

  user        User @relation(fields: [userId], references: [id])

  transactions Transaction[]

  @@index([userId])
  @@index([name])
}

model PriceChange {
  id              String   @id @default(uuid())
  userId          String
  subscriptionId  String
  transactionId   String
  previousAmount  Float
  newAmount       Float
  seen            Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([userId, subscriptionId])
  @@index([userId, seen])
}

model SubscriptionConflict {
  id              String   @id @default(uuid())
  userId          String
  transactionId   String
  subscriptionIds String[]
  resolved        Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([userId, resolved])
}

model NotificationRule {
  id        String @id @default(uuid())
  userId    String

  type            String // subscription_due, spending_summary
  enabled         Boolean @default(false)
  emailEnabled    Boolean @default(false)
  daysBefore      Int     @default(3)
  summaryFrequency String @default("weekly") // weekly, monthly

  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Notification {
  id        String @id @default(uuid())
  userId    String
  key       String
  type      String
  title     String
  body      String
  /// Ruta de la acción que el usuario puede ejecutar desde la notificación.
  actionUrl String?

  createdAt DateTime @default(now())
  readAt    DateTime?
  /// Momento en que se entregó el correo asociado; null significa que sigue pendiente.
  emailSentAt DateTime?

  user      User @relation(fields: [userId], references: [id])

  @@unique([userId, key])
  @@index([userId, readAt])
}

enum TransactionType {
  income
  expense
  transfer
}

enum TransferKind {
  internal
  external
}

enum CategoryType {
  needs
  leisure
  savings
  other
}

enum SubscriptionFrequency {
  weekly
  biweekly
  monthly
  bimonthly
  quarterly
  yearly
}

enum GoalReminderFrequency {
  WEEKLY
  MONTHLY
  CUSTOM
}

enum GoalReminderChannel {
  APP_ONLY
  APP_AND_EMAIL
}

enum GoalReminderIntervalUnit {
  DAYS
  WEEKS
  MONTHS
}
