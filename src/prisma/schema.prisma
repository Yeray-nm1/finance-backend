generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  createdAt   DateTime @default(now())

  accounts    Account[]
  transactions Transaction[]
  budgets     Budget[]
  monthlyBudgets MonthlyBudget[]
  subscriptions Subscription[]
  notificationRules NotificationRule[]
  notifications Notification[]
  savingsGoals SavingsGoal[]
  goalContributions GoalContribution[]
}

model Account {
  id        String   @id @default(uuid())
  userId    String
  name      String
  type      String   // checking, savings
  createdAt DateTime @default(now())

  user        User @relation(fields: [userId], references: [id])
  transactions Transaction[] @relation("TransactionAccount")
  incomingTransfers Transaction[] @relation("TransactionTransferAccount")
  savingsGoals SavingsGoal[]
  contributionDestinations GoalContribution[] @relation("ContributionDestination")
  contributionSources GoalContribution[] @relation("ContributionSource")

  @@index([userId])
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  accountId   String?
  transferAccountId String?
  categoryId  String?

  date        DateTime
  amount      Float
  description String
  type        TransactionType
  transferKind TransferKind?
  hash        String
  source      String   @default("manual")
  isSubscription Boolean @default(false)
  subscriptionId String?
  goalId      String?

  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  goal        SavingsGoal? @relation("GoalContributions", fields: [goalId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())

  user        User @relation(fields: [userId], references: [id])
  account     Account? @relation("TransactionAccount", fields: [accountId], references: [id])
  transferAccount Account? @relation("TransactionTransferAccount", fields: [transferAccountId], references: [id], onDelete: SetNull)
  category    Category? @relation(fields: [categoryId], references: [id])

  @@unique([userId, hash])
  @@index([userId, date])
  @@index([userId, categoryId])
  @@index([userId, amount])
  @@index([description])
  @@index([userId, subscriptionId])
  @@index([userId, transferAccountId])
  @@index([userId, goalId])
}

model SavingsGoal {
  id           String    @id @default(uuid())
  userId       String
  name         String
  targetAmount Float
  targetDate   DateTime?
  accountId    String?
  isArchived   Boolean   @default(false)
  /// Día del mes (1-28) en el que se envía el recordatorio mensual de la meta.
  reminderDay    Int?
  /// Cuota sugerida para la aportación manual que propone el recordatorio; si la aportación está programada, es el importe real del cargo.
  reminderAmount Float?
  /// Si la aportación mensual está programada y requiere aceptación por correo.
  contributionScheduled Boolean @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user          User          @relation(fields: [userId], references: [id])
  account       Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contributions Transaction[] @relation("GoalContributions")
  scheduledContributions GoalContribution[] @relation("ScheduledGoalContributions")

  @@index([userId, isArchived])
}

/// Aportación mensual propuesta por correo. El importe y la cuenta destino se
/// congelan al generarla para que coincidan con lo anunciado en el correo.
model GoalContribution {
  id          String    @id @default(uuid())
  userId      String
  goalId      String
  /// Periodo UTC del cargo, en formato YYYY-MM.
  period      String
  amount      Float
  goalAccountId String
  status      String    @default("pending")
  sourceAccountId String?
  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal      SavingsGoal @relation("ScheduledGoalContributions", fields: [goalId], references: [id], onDelete: Cascade)
  goalAccount Account   @relation("ContributionDestination", fields: [goalAccountId], references: [id], onDelete: Cascade)
  sourceAccount Account? @relation("ContributionSource", fields: [sourceAccountId], references: [id], onDelete: SetNull)

  @@unique([goalId, period])
  @@index([userId, status])
}

model Category {
  id        String @id @default(uuid())
  userId    String
  name      String
  type      CategoryType

  transactions    Transaction[]
  budgets         Budget[]

  @@index([userId])
}

model Budget {
  id         String   @id @default(uuid())
  userId     String
  categoryId String
  percentage Float
  month      Int
  year       Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([userId, categoryId, month, year])
  @@index([userId, month, year])
}

model MonthlyBudget {
  id              String   @id @default(uuid())
  userId          String
  month           Int
  year            Int
  totalIncome     Float
  typeAllocations Json
  categoryAllocations Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id])

  @@unique([userId, month, year])
  @@index([userId, month, year])
}

model Subscription {
  id          String   @id @default(uuid())
  userId      String

  name        String
  amount      Float
  frequency   SubscriptionFrequency
  active      Boolean  @default(true)

  matchDescriptions String[]  @default([])
  amountTolerance   Float     @default(10.0)

  createdAt   DateTime @default(now())

  user        User @relation(fields: [userId], references: [id])

  transactions Transaction[]

  @@index([userId])
  @@index([name])
}

model PriceChange {
  id              String   @id @default(uuid())
  userId          String
  subscriptionId  String
  transactionId   String
  previousAmount  Float
  newAmount       Float
  seen            Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([userId, subscriptionId])
  @@index([userId, seen])
}

model SubscriptionConflict {
  id              String   @id @default(uuid())
  userId          String
  transactionId   String
  subscriptionIds String[]
  resolved        Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([userId, resolved])
}

model NotificationRule {
  id        String @id @default(uuid())
  userId    String

  type            String // subscription_due, spending_summary
  enabled         Boolean @default(false)
  emailEnabled    Boolean @default(false)
  daysBefore      Int     @default(3)
  summaryFrequency String @default("weekly") // weekly, monthly

  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Notification {
  id        String @id @default(uuid())
  userId    String
  key       String
  type      String
  title     String
  body      String
  /// Ruta de la acción que el usuario puede ejecutar desde la notificación.
  actionUrl String?

  createdAt DateTime @default(now())
  readAt    DateTime?
  /// Momento en que se entregó el correo asociado; null significa que sigue pendiente.
  emailSentAt DateTime?

  user      User @relation(fields: [userId], references: [id])

  @@unique([userId, key])
  @@index([userId, readAt])
}

enum TransactionType {
  income
  expense
  transfer
}

enum TransferKind {
  internal
  external
}

enum CategoryType {
  needs
  leisure
  savings
  other
}

enum SubscriptionFrequency {
  weekly
  biweekly
  monthly
  bimonthly
  quarterly
  yearly
}
