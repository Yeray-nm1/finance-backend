generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  createdAt   DateTime @default(now())

  accounts    Account[]
  transactions Transaction[]
  budgets     Budget[]
  monthlyBudgets MonthlyBudget[]
  subscriptions Subscription[]
  notificationRules NotificationRule[]
  savingsGoals SavingsGoal[]
}

model Account {
  id        String   @id @default(uuid())
  userId    String
  name      String
  type      String   // checking, savings
  createdAt DateTime @default(now())

  user        User @relation(fields: [userId], references: [id])
  transactions Transaction[] @relation("TransactionAccount")
  incomingTransfers Transaction[] @relation("TransactionTransferAccount")
  savingsGoals SavingsGoal[]

  @@index([userId])
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  accountId   String?
  transferAccountId String?
  categoryId  String?

  date        DateTime
  amount      Float
  description String
  type        TransactionType
  transferKind TransferKind?
  hash        String
  source      String   @default("manual")
  isSubscription Boolean @default(false)
  subscriptionId String?
  goalId      String?

  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  goal        SavingsGoal? @relation("GoalContributions", fields: [goalId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())

  user        User @relation(fields: [userId], references: [id])
  account     Account? @relation("TransactionAccount", fields: [accountId], references: [id])
  transferAccount Account? @relation("TransactionTransferAccount", fields: [transferAccountId], references: [id], onDelete: SetNull)
  category    Category? @relation(fields: [categoryId], references: [id])

  @@unique([userId, hash])
  @@index([userId, date])
  @@index([userId, categoryId])
  @@index([userId, amount])
  @@index([description])
  @@index([userId, subscriptionId])
  @@index([userId, transferAccountId])
  @@index([userId, goalId])
}

model SavingsGoal {
  id           String    @id @default(uuid())
  userId       String
  name         String
  targetAmount Float
  targetDate   DateTime?
  accountId    String?
  isArchived   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user          User          @relation(fields: [userId], references: [id])
  account       Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contributions Transaction[] @relation("GoalContributions")

  @@index([userId, isArchived])
}

model Category {
  id        String @id @default(uuid())
  userId    String
  name      String
  type      CategoryType

  transactions    Transaction[]
  budgets         Budget[]

  @@index([userId])
}

model Budget {
  id         String   @id @default(uuid())
  userId     String
  categoryId String
  percentage Float
  month      Int
  year       Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([userId, categoryId, month, year])
  @@index([userId, month, year])
}

model MonthlyBudget {
  id              String   @id @default(uuid())
  userId          String
  month           Int
  year            Int
  totalIncome     Float
  typeAllocations Json
  categoryAllocations Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id])

  @@unique([userId, month, year])
  @@index([userId, month, year])
}

model Subscription {
  id          String   @id @default(uuid())
  userId      String

  name        String
  amount      Float
  frequency   SubscriptionFrequency
  active      Boolean  @default(true)

  matchDescriptions String[]  @default([])
  amountTolerance   Float     @default(10.0)

  createdAt   DateTime @default(now())

  user        User @relation(fields: [userId], references: [id])

  transactions Transaction[]

  @@index([userId])
  @@index([name])
}

model PriceChange {
  id              String   @id @default(uuid())
  userId          String
  subscriptionId  String
  transactionId   String
  previousAmount  Float
  newAmount       Float
  seen            Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([userId, subscriptionId])
  @@index([userId, seen])
}

model SubscriptionConflict {
  id              String   @id @default(uuid())
  userId          String
  transactionId   String
  subscriptionIds String[]
  resolved        Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([userId, resolved])
}

model NotificationRule {
  id        String @id @default(uuid())
  userId    String

  type      String // budget_exceeded, subscription_due, etc.
  threshold Float?
  categoryId String?

  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id])

  @@index([userId])
}

enum TransactionType {
  income
  expense
  transfer
}

enum TransferKind {
  internal
  external
}

enum CategoryType {
  needs
  leisure
  savings
  other
}

enum SubscriptionFrequency {
  weekly
  biweekly
  monthly
  bimonthly
  quarterly
  yearly
}
